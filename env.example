PORT=3000
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
DATABASE_URL=
# Optional PEM CA chain when the database endpoint requires it. Never disable validation.
DATABASE_CA_CERT=
# Only for isolated local PostgreSQL test instances. Never set true on Render.
DB_LOCAL_TEST=false
# Set the key directly in Render. Never commit it or paste it into chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Global per Taiwan calendar day. 0 disables external calls until budget is approved.
OPENAI_DAILY_CALL_LIMIT=0
